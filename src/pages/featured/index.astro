---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/featured-body.css';
import ld1 from './_jsonld-1.json?raw';
import hero from './_hero.html?raw';
import body from './_body.html?raw';
import cta from './_cta.html?raw';
---
<BaseLayout
  title="Featured In — Guides That Recommend tabemasen | tabemasen"
  description="Travel guides and family resources that recommend tabemasen, the free Japanese restaurant card for food allergies and dietary restrictions."
  canonical="https://tabemasen.io/featured/"
  jsonLd={[ld1.trim()]}
  page="featured"
  current="/featured/"
>
  <main class="tm-container page-featured">
    <section class="ft-hero" set:html={hero} />
    <Fragment set:html={body} />
    <Fragment set:html={cta} />
  </main>
</BaseLayout>
