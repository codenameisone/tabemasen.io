---
import { getCollection } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { relatedGuides } from '../../../lib/guides';
import bakery from '../../../assets/illustrations/bakery.jpg';
import '../../../styles/food-allergies-body.css';
import ld1 from './_jsonld-1.json?raw';
import ld2 from './_jsonld-2.json?raw';
import ld3 from './_jsonld-3.json?raw';
import hero from './_hero.html?raw';
import body from './_body.html?raw';
import cta from './_cta.html?raw';

const related = relatedGuides(await getCollection('guides'), 'allergies', 'food-allergies-in-japanese');
---
<GuideLayout
  title={'How to Say "I Have a Food Allergy" in Japanese | tabemasen'}
  description={'「小麦アレルギーがあります」— "I have a wheat allergy." The exact phrase for every major allergen, in kanji with readings, plus a free card for staff.'}
  canonical="https://tabemasen.io/allergies/food-allergies-in-japanese/"
  jsonLd={[ld1.trim(), ld2.trim(), ld3.trim()]}
  page="allergies-phrases"
  current="/allergies/"
  illustration={{ src: bakery, alt: 'Watercolour sketch: at a Japanese bakery counter, a traveller holds up a small card and the shop assistant leans in to read it' }}
  related={related}
>
  <Fragment slot="head">
    <meta property="article:section" content="Allergies">
    <meta property="article:tag" content="Japanese allergy phrases">
    <meta property="article:tag" content="Allergen kanji">
    <meta property="article:tag" content="Food allergy travel Japan">
  </Fragment>
  <Fragment slot="hero" set:html={hero} />
  <Fragment set:html={body} />
  <Fragment slot="cta" set:html={cta} />
</GuideLayout>
