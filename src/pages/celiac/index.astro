---
import { getCollection } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { relatedGuides } from '../../lib/guides';
import supermarket from '../../assets/illustrations/supermarket.jpg';
import '../../styles/card.css';
import '../../styles/celiac-body.css';
import ld1 from './_jsonld-1.json?raw';
import ld2 from './_jsonld-2.json?raw';
import ld3 from './_jsonld-3.json?raw';
import hero from './_hero.html?raw';
import body from './_body.html?raw';
import cta from './_cta.html?raw';
import { exampleCardHtml } from '../../lib/cardData';
import { insertAtMarker } from '../../lib/fragments';

const bodyWithCard = insertAtMarker(body, '<!-- example-card -->', `<figure class="ce-example">
        ${exampleCardHtml({ patterns: ['gluten-free'], showEnglish: false }, 'Example gluten-free card in Japanese')}
        <figcaption>What the kitchen sees: the gluten-free card, word for word as the generator makes it. Your copy also has the English underneath.</figcaption>
      </figure>`);
const related = relatedGuides(await getCollection('guides'), 'gluten-free', 'celiac');
---
<GuideLayout
  title={'Celiac / Coeliac in Japan: Why "No Wheat" Isn\'t Gluten-Free | tabemasen'}
  description={'Japan\'s allergen law covers wheat — not barley, rye or gluten. What a Japanese label actually guarantees, and how celiacs (coeliacs) can verify food themselves.'}
  ogDescription="Japan's allergen law covers wheat — not barley, rye or gluten. What a Japanese label guarantees, and how celiacs (coeliacs) verify food themselves."
  twitterDescription="Japan's allergen law covers wheat — not barley, rye or gluten. What a Japanese label guarantees, and how celiacs verify food themselves."
  canonical="https://tabemasen.io/celiac/"
  jsonLd={[ld1.trim(), ld2.trim(), ld3.trim()]}
  page="celiac"
  current="/gluten-free-japan/"
  illustration={{ src: supermarket, alt: 'Watercolour sketch: a traveller in a Japanese supermarket aisle turns over a packet of rice crackers to read the label' }}
  related={related}
>
  <Fragment slot="head">
    <meta property="article:section" content="Celiac">
    <meta property="article:tag" content="Celiac disease Japan">
    <meta property="article:tag" content="Gluten-free labelling Japan">
    <meta property="article:tag" content="Japan allergen law">
  </Fragment>
  <Fragment slot="hero" set:html={hero} />
  <Fragment set:html={bodyWithCard} />
  <Fragment slot="cta" set:html={cta} />
</GuideLayout>
