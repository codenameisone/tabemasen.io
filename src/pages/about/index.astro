---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/about-body.css';
import ld1 from './_jsonld-1.json?raw';
import hero from './_hero.html?raw';
import body from './_body.html?raw';
import cta from './_cta.html?raw';
---
<BaseLayout
  title="About & Safety — How the Cards Are Made | tabemasen"
  description="How tabemasen cards are put together, what they can and can't do, how corrections work, your privacy, and what to carry if you have a serious allergy in Japan."
  canonical="https://tabemasen.io/about/"
  jsonLd={[ld1.trim()]}
  page="about"
  current="/about/"
>
  <main class="tm-container page-about">
    <section class="ab-hero" set:html={hero} />
    <Fragment set:html={body} />
    <Fragment set:html={cta} />
  </main>
</BaseLayout>
