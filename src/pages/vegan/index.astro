---
import HubLayout from '../../layouts/HubLayout.astro';
import shojin from '../../assets/illustrations/shojin.jpg';
import jsonLd from './_jsonld.json?raw';
import body from './_body.html?raw';
import '../../styles/vegan-body.css';
---
<HubLayout
  title="Japan Vegan Restaurant Card — Free Generator | tabemasen"
  description="Free Japanese vegan restaurant card for travelers. Calls out the dashi problem — fish stock hidden in nearly every dish — plus a practical guide to eating vegan in Japan: shojin ryori, what to order, and the konbini reality."
  canonical="https://tabemasen.io/vegan/"
  jsonLd={[jsonLd.trim()]}
  page="vegan"
  diet="vegan"
  eyebrow="Free generator"
  h1="Japan vegan restaurant card"
  lede="Pick vegan, get a polite Japanese card to show your waiter. Calls out dashi, bonito flakes, eggs, and the hidden animal stocks that turn an apparently-vegetable dish into something you can't eat."
  microcopy="No signup · Free"
  reviewed="October 2026"
  illustration={{ src: shojin, alt: 'Watercolour sketch: a Buddhist temple vegetarian meal of small dishes on a red lacquered tray, a moss garden beyond the paper door' }}
  picker={{ allergenKeys: ['wheat', 'buckwheat', 'peanut', 'walnut', 'cashew', 'sesame', 'soy'], showSeverity: false, event: 'cta-vegan-hero' }}
  example={{ allergens: [], severity: 'allergy', showEnglish: true }}
  ctaLabel="Generate my Japanese vegan card →"
  closing={{ heading: 'Ready to generate yours?', text: 'Free, no signup, takes about 30 seconds. Pick vegan, customise the dashi/bonito callouts, and add other dietary needs.', event: 'cta-vegan-footer' }}
>
  <Fragment set:html={body} />
</HubLayout>
