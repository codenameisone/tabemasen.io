---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="msvalidate.01" content="739633B14AA9EF483F9FA562680C9A0F" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Japan Allergy Card — Free Japanese Restaurant Translation Card | tabemasen</title>
  <meta name="description" content="Free generator for Japanese restaurant cards. Show your food allergies, vegetarian, vegan, halal, or gluten-free needs to staff in polite Japanese. No signup. Mobile-friendly.">

  <link rel="canonical" href="https://tabemasen.io/">

  <!-- Open Graph -->
  <meta property="og:title" content="Japan Allergy Card — Free Japanese Restaurant Translation Card | tabemasen">
  <meta property="og:description" content="Free generator for Japanese restaurant cards. Show your food allergies, vegetarian, vegan, halal, or gluten-free needs to staff in polite Japanese. No signup. Mobile-friendly.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://tabemasen.io/">
  <meta property="og:image" content="https://tabemasen.io/assets/og-image.png">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Japan Allergy Card — Free Japanese Restaurant Translation Card | tabemasen">
  <meta name="twitter:description" content="Free generator for Japanese restaurant cards. Show your food allergies, vegetarian, vegan, halal, or gluten-free needs to staff in polite Japanese. No signup. Mobile-friendly.">

  <!-- Structured data -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://tabemasen.io/#organization",
        "name": "tabemasen",
        "alternateName": "食べません",
        "url": "https://tabemasen.io/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://tabemasen.io/assets/android-chrome-512.png"
        },
        "description": "Free Japanese restaurant cards for travelers with food allergies and dietary restrictions. The name tabemasen (食べません) is Japanese for \"I don't eat\".",
        "sameAs": ["https://github.com/codenameisone/tabemasen.io"]
      },
      {
        "@type": "WebSite",
        "@id": "https://tabemasen.io/#website",
        "name": "tabemasen",
        "alternateName": "食べません",
        "url": "https://tabemasen.io/",
        "inLanguage": "en",
        "publisher": { "@id": "https://tabemasen.io/#organization" }
      },
      {
        "@type": "WebApplication",
        "name": "tabemasen",
        "url": "https://tabemasen.io/",
        "description": "Free generator for Japanese restaurant cards covering food allergies, vegetarian, vegan, halal, kosher, and gluten-free dietary needs.",
        "applicationCategory": "TravelApplication",
        "operatingSystem": "Any",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "inLanguage": ["en", "ja"],
        "audience": {
          "@type": "Audience",
          "audienceType": "Travelers to Japan with dietary restrictions"
        },
        "publisher": { "@id": "https://tabemasen.io/#organization" }
      }
    ]
  }
  </script>

  <link rel="icon" type="image/x-icon" href="assets/favicon.ico">
<link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="assets/favicon-16.png">
<link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- ═══════════════════════════════════════════════════════════
       HEADER
  ═══════════════════════════════════════════════════════════ -->
  <SiteHeader page="home" />

  <!-- ═══════════════════════════════════════════════════════════
       MAIN
  ═══════════════════════════════════════════════════════════ -->
  <main class="main-content">

    <section class="app-intro">
      <h1 class="app-title">Generate your Japanese restaurant card</h1>
      <p class="app-lede">Pick your allergies and diet below — your card builds live as you choose. Show it on your phone or download a PNG to keep offline.</p>
      <p class="app-safety-note">Best used as a safety net — when possible, plan around dedicated GF/allergy-friendly restaurants.</p>
      <h2 class="site-seo-heading">Free Japanese restaurant cards for food allergies, vegetarian, vegan, halal &amp; gluten-free travelers</h2>
    </section>

    <div class="app-grid">

    <!-- ──── Selection panel ─────────────────────────────── -->
    <section class="selection-panel" aria-label="Card options">

      <!-- Allergens -->
      <div class="panel-section" id="panel-allergens">
        <h2 class="panel-heading">
          <button class="panel-toggle" aria-expanded="true" aria-controls="allergens-content" type="button">
            <span>Allergens</span>
            <span class="panel-chevron" aria-hidden="true">▼</span>
          </button>
        </h2>
        <div class="panel-body" id="allergens-content">
          <div class="chip-grid" role="group" aria-label="Select allergens">
            <!-- Chips injected by app.js -->
          </div>
        </div>
      </div>

      <!-- Diet -->
      <div class="panel-section" id="panel-diet">
        <h2 class="panel-heading">
          <button class="panel-toggle" aria-expanded="true" aria-controls="diet-content" type="button">
            <span>Diet</span>
            <span class="panel-chevron" aria-hidden="true">▼</span>
          </button>
        </h2>
        <div class="panel-body" id="diet-content">
          <p class="field-hint">Select multiple at once — e.g. gluten-free + pescatarian.</p>
          <div class="pattern-list" role="group" aria-label="Select dietary pattern">
            <!-- Pattern buttons injected by app.js -->
          </div>
        </div>
      </div>

      <!-- Severity -->
      <div class="panel-section" id="panel-severity">
        <h2 class="panel-heading">
          <button class="panel-toggle" aria-expanded="true" aria-controls="severity-content" type="button">
            <span>Severity</span>
            <span class="panel-chevron" aria-hidden="true">▼</span>
          </button>
        </h2>
        <div class="panel-body" id="severity-content">
          <p class="field-hint">When checked, the card warns that even trace amounts can be life-threatening and asks staff to use separate utensils.</p>
          <div class="severity-options" role="group" aria-label="Select severity">
            <label class="severity-option">
              <input type="checkbox" id="severity-toggle" name="severity">
              <span class="severity-label">🚨 Severe allergy</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Optional -->
      <div class="panel-section" id="panel-optional">
        <h2 class="panel-heading">
          <button class="panel-toggle" aria-expanded="false" aria-controls="optional-content" type="button">
            <span>Name &amp; custom item</span>
            <span class="panel-chevron" aria-hidden="true">▼</span>
          </button>
        </h2>
        <div class="panel-body hidden" id="optional-content">
          <div class="optional-fields">
            <div class="field-group">
              <label for="name-input" class="field-label">Your first name (optional)</label>
              <input
                id="name-input"
                type="text"
                class="text-input"
                placeholder="e.g. Sarah"
                autocomplete="given-name"
                maxlength="40"
              >
            </div>
            <div class="field-group">
              <label for="custom-input" class="field-label">Custom item to add to card</label>
              <textarea
                id="custom-input"
                class="text-input textarea-input"
                placeholder="Paste any text (in any language) as-is on the card"
                rows="2"
                maxlength="200"
              ></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Clear -->
      <div class="panel-tools">
        <button type="button" class="clear-btn" id="clear-btn">Clear all</button>
      </div>

    </section><!-- /selection-panel -->

    <!-- ──── Live card preview ──────────────────────────── -->
    <section class="card-preview-section" aria-label="Card preview" aria-live="polite">
      <div class="card-preview-header">
        <p class="preview-label">Your card</p>
        <label class="english-toggle-label">
          <input type="checkbox" id="english-toggle" checked>
          <span>Show English</span>
        </label>
      </div>
      <div class="card" id="card" tabindex="0" aria-label="Japanese restaurant card preview">
        <!-- Card content injected by app.js -->
      </div>
    </section>

    </div><!-- /.app-grid -->

  </main>

  <!-- ═══════════════════════════════════════════════════════════
       ACTION BUTTONS (sticky bottom bar)
  ═══════════════════════════════════════════════════════════ -->
  <div class="action-bar" role="toolbar" aria-label="Card actions">
    <button type="button" class="btn btn--ghost btn--action" id="copy-btn">
      <span class="btn-icon" aria-hidden="true">🔗</span>
      <span class="btn-text">Copy Link</span>
    </button>
    <button type="button" class="btn btn--primary btn--action" id="download-btn">
      <span class="btn-icon" aria-hidden="true">⬇</span>
      <span class="btn-text">Download PNG</span>
    </button>
    <button type="button" class="btn btn--ghost btn--action" id="print-btn">
      <span class="btn-icon" aria-hidden="true">🖨</span>
      <span class="btn-text">Print</span>
    </button>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       FOOTER
  ═══════════════════════════════════════════════════════════ -->
  <SiteFooter page="home" />

  <!-- html2canvas — lazy-loaded only when Download is clicked -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>
  <script is:inline src="/analytics.js"></script>
  <script is:inline src="data.js"></script>
  <script is:inline src="app.js"></script>
  <script is:inline data-goatcounter="https://nqtn.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
</body>
</html>
