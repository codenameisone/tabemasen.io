---
import { getCollection } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { relatedGuides } from '../../../lib/guides';
import certDoor from '../../../assets/illustrations/cert-door.jpg';
import '../../../styles/halal-certification-guide-body.css';
import ld1 from './_jsonld-1.json?raw';
import ld2 from './_jsonld-2.json?raw';
import ld3 from './_jsonld-3.json?raw';
import hero from './_hero.html?raw';
import toc from './_toc.html?raw';
import body from './_body.html?raw';
import cta from './_cta.html?raw';

const related = relatedGuides(await getCollection('guides'), 'halal', 'halal-certification-guide');
---
<GuideLayout
  title="Japan Halal Certification & Logos Explained | tabemasen"
  description="Confused by halal logos in Japan? A clear guide to the main certification bodies, what each symbol means, and how to tell if a Japanese restaurant is genuinely halal-certified."
  canonical="https://tabemasen.io/halal/certification-guide/"
  jsonLd={[ld1.trim(), ld2.trim(), ld3.trim()]}
  page="halal-cert"
  current="/halal/"
  illustration={{ src: certDoor, alt: 'Watercolour sketch: a hand pulls open a Japanese restaurant\'s glass door; inside hang a round sign and a small wooden plaque' }}
  related={related}
>
  <Fragment slot="head">
    <meta property="article:section" content="Halal">
    <meta property="article:tag" content="Halal certification Japan">
    <meta property="article:tag" content="JHA">
    <meta property="article:tag" content="Muslim travel">
  </Fragment>
  <Fragment slot="hero" set:html={hero} />
  <Fragment slot="toc" set:html={toc} />
  <Fragment set:html={body} />
  <Fragment slot="cta" set:html={cta} />
</GuideLayout>
