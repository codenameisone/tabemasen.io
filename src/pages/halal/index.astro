---
import HubLayout from '../../layouts/HubLayout.astro';
import street from '../../assets/illustrations/halal-street.jpg';
import jsonLd from './_jsonld.json?raw';
import body from './_body.html?raw';
import '../../styles/halal-body.css';
---
<HubLayout
  title="Halal in Japan: Free Muslim Restaurant Card + Dining Guide | tabemasen"
  description="Free Japanese restaurant card for Muslim travelers — no pork, no alcohol, no mirin — plus how to find halal-certified restaurants in Japan and read halal labels."
  canonical="https://tabemasen.io/halal/"
  jsonLd={[jsonLd.trim()]}
  page="halal"
  diet="halal"
  eyebrow="Free generator"
  h1="Japan halal restaurant card"
  lede="Pick halal, get a polite Japanese dietary card for Muslim travelers to show your waiter. Calls out pork in all its hidden forms, alcohol-based seasonings like mirin and sake, and the shared-kitchen risks that turn an apparently-fish dish into something you can't eat."
  microcopy="No signup · Free"
  reviewed="October 2026"
  illustration={{ src: street, alt: 'Watercolour sketch: a Muslim traveller couple read a standing menu board outside a small Japanese restaurant on an evening street' }}
  picker={{ allergenKeys: ['shrimp', 'crab', 'wheat', 'buckwheat', 'egg', 'dairy', 'peanut', 'walnut', 'cashew', 'sesame', 'soy', 'fish'], showSeverity: false, event: 'cta-halal-hero' }}
  example={{ allergens: [], severity: 'allergy', showEnglish: true }}
  ctaLabel="Generate my Japanese halal card →"
  closing={{ heading: 'Ready to generate yours?', text: 'Free, no signup, takes about 30 seconds. Pick halal, set your strictness on trace alcohol, and add other dietary needs.', event: 'cta-halal-footer' }}
>
  <Fragment set:html={body} />
</HubLayout>
