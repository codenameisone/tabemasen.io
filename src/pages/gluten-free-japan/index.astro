---
import HubLayout from '../../layouts/HubLayout.astro';
import sushi from '../../assets/illustrations/sushi.jpg';
import jsonLd1 from './_jsonld-1.json?raw';
import jsonLd2 from './_jsonld-2.json?raw';
import jsonLd3 from './_jsonld-3.json?raw';
import body from './_body.html?raw';
import heroExtra from './_hero-extra.html?raw';
import '../../styles/gluten-free-body.css';
---
<HubLayout
  title="Gluten-Free in Japan — Free Celiac & Coeliac Card and Guide | tabemasen"
  description="Everything celiacs and coeliacs need to know about eating gluten-free in Japan — hidden wheat in soy sauce, dashi, and barley tea, safe foods to look for, convenience store tips, and a free Japanese restaurant card to show your waiter."
  canonical="https://tabemasen.io/gluten-free-japan/"
  jsonLd={[jsonLd1.trim(), jsonLd2.trim(), jsonLd3.trim()]}
  page="gluten-free"
  diet="gluten-free"
  eyebrow="Free restaurant card generator"
  h1="Gluten-free in Japan"
  lede="A free Japanese allergy card — sometimes called a chef card or translation card — that you show your waiter. It explains your restriction in polite Japanese, calls out wheat in soy sauce and dashi, and asks about cross-contamination. The things phrasebooks miss."
  microcopy="No signup · Free"
  reviewed="October 2026"
  heroExtra={heroExtra}
  illustration={{ src: sushi, alt: 'Watercolour sketch: a sushi counter with nigiri, rice, green tea and two small soy sauce bottles, the chef working behind' }}
  picker={{ allergenKeys: ['egg', 'dairy', 'soy', 'sesame', 'buckwheat', 'peanut', 'shrimp', 'crab', 'fish'], showSeverity: true, event: 'cta-gluten-free-hero' }}
  example={{ allergens: [], severity: 'allergy', showEnglish: true }}
  ctaLabel="Generate my Japanese gluten-free card →"
  closing={{ heading: 'Ready to generate yours?', text: 'Free, no signup, takes about 30 seconds. Customise allergens, severity, and add other dietary needs.', event: 'cta-gluten-free-footer' }}
>
  <Fragment set:html={body} />
</HubLayout>
